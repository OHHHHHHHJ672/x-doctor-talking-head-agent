# 云端 HTTPS 根地址（无末尾斜杠）。开发时 Vite 将 /api、/dl 代理到此处。
VITE_CLOUD_API_BASE_URL=https://your-server.example.com

# 若服务端「数字人成片」路径与默认不一致，请对照 GET /api/v1/meta 后填写：
# VITE_V1_DIGITAL_HUMAN_SUBMIT=/api/v1/digital-human/video/submit
# VITE_V1_DIGITAL_HUMAN_STATUS=/api/v1/digital-human/video/status

# 数字人工作流（当前后端实际走 RunningHub compose/sync）
# 这些值来自服务器 runninghub_client_fixed.py，若后端改节点请同步这里：
# VITE_RH_DH_WORKFLOW_ID=2046420487177244674
# VITE_RH_DH_VIDEO_NODE=1
# VITE_RH_DH_VIDEO_FIELD=file
# VITE_RH_DH_AUDIO_NODE=7
# VITE_RH_DH_AUDIO_FIELD=audio
# VITE_RH_DH_TEXT_NODE=24
# VITE_RH_DH_TEXT_FIELD=text
